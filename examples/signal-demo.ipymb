    "source": "# Plan → Code → Check\nCreate a small signal, remove its mean, and check the result. The imported graph preserves notebook execution order.",
    "outputs": []
   },
   {
    "id": "load-signal",
    "cell_type": "code",
    "metadata": {
     "mainaiger": {
      "title": "Load signal"
     }
    },
    "source": "signal = [1.0, 2.0, 4.0, 5.0]\nprint(signal)",
    "outputs": [],
    "execution_count": null
   },
   {
    "id": "center-signal",
    "cell_type": "code",
    "metadata": {
     "mainaiger": {
      "title": "Center the signal"
     }
    },
    "source": "mean = sum(signal) / len(signal)\ncentered = [value - mean for value in signal]\nprint(centered)",
    "outputs": [],
    "execution_count": null
   },
   {
    "id": "check-signal",
    "cell_type": "code",
    "metadata": {
     "mainaiger": {
      "title": "Check the result"
     }
    },
    "source": "assert abs(sum(centered)) < 1e-12\nprint('Check passed: centered signal has zero sum.')",
    "outputs": [],
    "execution_count": null
   }
  ]
