      "mainaiger_example": "No external dependencies; run in a Python notebook."
    },
    "cells": [
      {
        "id": "plan",
        "cell_type": "markdown",
        "metadata": {},
        "source": [
          "# Plan → Code → Check\n",
          "Create a small signal, remove its mean, and check the result. The imported graph preserves notebook execution order."
        ]
      },
      {
        "id": "load-signal",
        "cell_type": "code",
        "metadata": {},
        "source": [
          "signal = [1.0, 2.0, 4.0, 5.0]\n",
          "print(signal)"
        ],
        "execution_count": null,
        "outputs": []
      },
      {
        "id": "center-signal",
        "cell_type": "code",
        "metadata": {},
        "source": [
          "mean = sum(signal) / len(signal)\n",
          "centered = [value - mean for value in signal]\n",
          "print(centered)"
        ],
        "execution_count": null,
        "outputs": []
      },
      {
        "id": "check-signal",
        "cell_type": "code",
        "metadata": {},
        "source": [
          "assert abs(sum(centered)) < 1e-12\n",
          "print('Check passed: centered signal has zero sum.')"
        ],
        "execution_count": null,
        "outputs": []
      }
    ]
  },
