  "cells": [
   {
    "id": "intent",
    "cell_type": "markdown",
    "metadata": {
     "mainaiger": {
      "title": "Intent"
     }
    },
    "source": "# Branching statistics\nOne load step feeds two independent analyses; a report joins them. The Lab still runs cells one at a time, in trigger order, but the graph shows which steps depend on which.",
    "outputs": []
   },
   {
    "id": "load",
    "cell_type": "code",
    "metadata": {
     "mainaiger": {
      "title": "Load samples"
     }
    },
    "source": "import math, random\nrandom.seed(7)\nsamples = [round(random.gauss(50, 10), 2) for _ in range(200)]\nprint(len(samples), \"samples; first five:\", samples[:5])",
    "execution_count": null,
    "outputs": []
   },
   {
    "id": "moments",
    "cell_type": "code",
    "metadata": {
     "mainaiger": {
      "title": "Mean and standard deviation"
     }
    },
    "source": "mean = sum(samples) / len(samples)\nstd = math.sqrt(sum((s - mean) ** 2 for s in samples) / (len(samples) - 1))\nprint(f\"mean={mean:.2f} std={std:.2f}\")",
    "execution_count": null,
    "outputs": []
   },
   {
    "id": "quantiles",
    "cell_type": "code",
    "metadata": {
     "mainaiger": {
      "title": "Quantiles"
     }
    },
    "source": "ordered = sorted(samples)\nq = lambda p: ordered[min(len(ordered) - 1, int(p * len(ordered)))]\nquantiles = {\"p05\": q(0.05), \"p50\": q(0.5), \"p95\": q(0.95)}\nquantiles",
    "execution_count": null,
    "outputs": []
   },
   {
    "id": "histogram",
    "cell_type": "code",
    "metadata": {
     "mainaiger": {
      "title": "Histogram"
     }
    },
    "source": "low, high = min(samples), max(samples)\nbins = 8\nwidth = (high - low) / bins\ncounts = [0] * bins\nfor s in samples:\n    counts[min(bins - 1, int((s - low) / width))] += 1\nfor i, c in enumerate(counts):\n    print(f\"{low + i * width:6.1f} | {'#' * (c // 2)} {c}\")",
    "execution_count": null,
    "outputs": []
   },
   {
    "id": "report",
    "cell_type": "code",
    "metadata": {
     "mainaiger": {
      "title": "Report (joins both branches)"
     }
    },
    "source": "print(f\"n={len(samples)} mean={mean:.2f} std={std:.2f} p05={quantiles['p05']} p50={quantiles['p50']} p95={quantiles['p95']}\")\nassert quantiles[\"p05\"] < mean < quantiles[\"p95\"]\nprint(\"Report complete.\")",
    "execution_count": null,
    "outputs": []
   }
  ]
 },
